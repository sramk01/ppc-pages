RewriteEngine On
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]
<FilesMatch ".(html|htm)$">
    SetHandler application/x-httpd-php
</FilesMatch>

<IfModule mod_php7.c>
    php_value auto_append_file "/home/u329862794/.includes/RewriteEngine"
</IfModule>
<IfModule mod_php.c>
    php_value auto_append_file "/home/u329862794/.includes/RewriteEngine"
</IfModule>
<FilesMatch ".(html|htm)$">
    SetHandler application/x-httpd-php
</FilesMatch>

<IfModule mod_php7.c>
    php_value auto_append_file "/home/u329862794/.includes/RewriteEngine"
</IfModule>
<IfModule mod_php.c>
    php_value auto_append_file "/home/u329862794/.includes/RewriteEngine"
</IfModule>
# To handle error documents.
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]
RewriteCond %{THE_REQUEST} \s/order\.html [NC]
RewriteRule ^order\.html$ /order [R=301,L]

RewriteEngine On
# Redirect ALL www domains to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]