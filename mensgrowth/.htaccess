RewriteEngine On
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]



# To handle error documents.
ErrorDocument 404 /404.html


RewriteEngine On
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]


RewriteCond %{THE_REQUEST} \s/order\.html [NC]
RewriteRule ^order\.html$ /order [R=301,L]